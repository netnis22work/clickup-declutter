{
  "manifest_version": 3,
  "name": "ClickUp Declutter",
  "version": "1.0.0",
  "description": "Hide AI, chat, upsell and popup clutter in ClickUp.",
  "permissions": ["storage"],
  "host_permissions": ["https://app.clickup.com/*"],
  "content_scripts": [
    {
      "matches": ["https://app.clickup.com/*"],
      "js": ["rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ClickUp Declutter",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
